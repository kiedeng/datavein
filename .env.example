# === 存储 ===
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=datavein
MYSQL_USER=datavein
MYSQL_PASSWORD=change_me
REDIS_URL=redis://127.0.0.1:6379/0
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000

# === 数据源(M1 对接)===
# Hive Metastore 后端库只读账号(直读 TBLS/DBS/COLUMNS_V2)
METASTORE_DB_HOST=
METASTORE_DB_PORT=3306
METASTORE_DB_NAME=hive
METASTORE_DB_USER=
METASTORE_DB_PASSWORD=
METASTORE_OWNER_PARAM_KEYS=owner,created_by
# 调度平台 REST(字段映射 JSON:平台字段名->标准字段名,换平台只改配置)
SCHEDULER_API_BASE=http://scheduler.internal
SCHEDULER_API_TOKEN=change_me
SCHEDULER_SQL_ENDPOINT=/api/v1/task-sqls
SCHEDULER_FIELD_MAP={}

# === MCP 服务 ===
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_AUTH_TOKEN=change_me
GATEWAY_URL=http://query-gateway:8090
GATEWAY_TOKEN=change_me

# === 查询网关(M4,唯一持有数仓凭据的组件)===
WAREHOUSE_HOST=
WAREHOUSE_PORT=3306
WAREHOUSE_DB=
WAREHOUSE_USER=
WAREHOUSE_PASSWORD=
WAREHOUSE_DIALECT=mysql
QUERY_HARD_LIMIT=1000
QUERY_TIMEOUT_MS=30000
BLACKLIST_TABLES=
# 兜底 Text-to-SQL 的 LLM 端点(new-api,OpenAI 兼容)
ADHOC_LLM_BASE_URL=
ADHOC_LLM_API_KEY=
ADHOC_LLM_MODEL=deepseek-chat

# === L3 向量检索(6.4;EMBEDDING_URL 未配置用 HashEmbedder,仅测试/无模型环境)===
EMBEDDING_URL=

# === 解析 ===
SQL_DIALECT_DEFAULT=hive
PARSE_TIMEOUT_SECONDS=60
PARALLEL_WORKERS=8

# === 闭包(设计方案 2.2)===
CLOSURE_INCR_DEGRADE_THRESHOLD=5000000

# === Web 门户(M3/M5;LLM_BASE_URL 不配置即 9.3 降级结构化模式)===
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
PORTAL_HOST=0.0.0.0
PORTAL_PORT=8091

# === 生产部署(deploy/docker-compose.prod.yml)===
MYSQL_ROOT_PASSWORD=change_me
DATA_DIR=/data/datavein
BACKUP_DIR=/data/datavein/backup
TLS_CERT_DIR=/data/datavein/tls
REBUILD_HOUR=3
REBUILD_EDGE_DELTA_MAX=0.20
REBUILD_CLOSURE_DELTA_MAX=0.10
